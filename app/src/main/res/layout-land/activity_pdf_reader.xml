<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_bg">

    <com.lumepdf.app.ui.ZoomableRecyclerView
        android:id="@+id/rvPages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="10dp" />

    <!-- Unobtrusive Corner Page Pill while reading -->
    <TextView
        android:id="@+id/tvCornerPagePill"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_reader_bar"
        android:elevation="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="1 / 1"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Slim Landscape Floating Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_gravity="top"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_reader_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvReaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnCropToggle"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Crop white margins"
            android:padding="7dp"
            android:src="@drawable/ic_crop" />

        <ImageButton
            android:id="@+id/btnNightToggle"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle reading contrast"
            android:padding="7dp"
            android:src="@drawable/ic_night_mode" />
    </LinearLayout>

    <!-- Compact Centered Landscape Bottom Scrubber -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="400dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_reader_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/tvPageCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:minWidth="48dp"
            android:text="1 / 1"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressReader"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/readerError"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReaderError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
