<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LumePDF" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:windowBackground">@drawable/bg_ambient</item>
    </style>

    <style name="Theme.LumePDF.Reader" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:windowBackground">@color/reader_bg</item>
    </style>

    <style name="Theme.LumePDF.GlassDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
